<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Abstractions\LatticeLog.Abstractions.csproj" />
    <ProjectReference Include="..\LatticeLog.Storage\LatticeLog.Storage.csproj" />
    <!-- The source generator ships inside this package (analyzers/dotnet/cs): one package gives typed events. -->
    <ProjectReference Include="..\LatticeLog.Generator\LatticeLog.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishTrimmed;PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LatticeLog.Generator\bin\$(Configuration)\netstandard2.0\LatticeLog.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>LatticeLog logger: bounded lock-free queue, writer thread with Fast/Balanced/Durable modes, verifiable acknowledgements, redaction and the [LatticeEvent] source generator.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
