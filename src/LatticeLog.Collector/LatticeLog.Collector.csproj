<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>latticelog-collector</AssemblyName>
    <RootNamespace>LatticeLog.Collector</RootNamespace>
    <Description>LatticeLog collector service: receives batches from forwarders (specs/ingest-protocol.md) into a local store.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Server\LatticeLog.Server.csproj" />
  </ItemGroup>

</Project>
