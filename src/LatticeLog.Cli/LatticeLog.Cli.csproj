<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Core\LatticeLog.Core.csproj" />
    <ProjectReference Include="..\LatticeLog.Query\LatticeLog.Query.csproj" />
    <ProjectReference Include="..\LatticeLog.Evidence\LatticeLog.Evidence.csproj" />
    <ProjectReference Include="..\LatticeLog.OpenTelemetry\LatticeLog.OpenTelemetry.csproj" />
    <ProjectReference Include="..\LatticeLog.Mcp\LatticeLog.Mcp.csproj" />
    <ProjectReference Include="..\LatticeLog.Sources\LatticeLog.Sources.csproj" />
    <ProjectReference Include="..\LatticeLog.Service\LatticeLog.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>latticelog</AssemblyName>
    <!-- Windows: the icon Explorer, the taskbar and the installer show (Native AOT keeps it in the single file). -->
    <ApplicationIcon>latticelog.ico</ApplicationIcon>
    <RootNamespace>LatticeLog.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TargetFramework>net10.0</TargetFramework>
    <Description>latticelog command-line tool: query, trace, context packs, verify, export/import and a read-only MCP server.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>latticelog</ToolCommandName>
    <PackageId>LatticeLog.Cli</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
