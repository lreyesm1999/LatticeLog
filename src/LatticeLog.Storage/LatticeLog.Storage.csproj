<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>LatticeLog storage engine: open .llog binary segment format (writer, reader, recovery, compaction) and lossless JSONL exchange.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fault injection hooks for the durability thread (slow or failing disk) are internal and test-only. -->
    <InternalsVisibleTo Include="LatticeLog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Abstractions\LatticeLog.Abstractions.csproj" />
  </ItemGroup>

</Project>
