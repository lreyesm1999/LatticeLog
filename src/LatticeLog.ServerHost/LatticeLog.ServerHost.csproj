<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>latticelog-server</AssemblyName>
    <RootNamespace>LatticeLog.ServerHost</RootNamespace>
    <Description>latticelog-server: ingestion and read API over per-namespace LatticeLog stores (specs/server-api.md).</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Server\LatticeLog.Server.csproj" />
  </ItemGroup>

</Project>
