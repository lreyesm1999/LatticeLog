<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>LatticeLog server (P16-P17): HTTP ingestion with idempotent deduplication and group commit, plus a read API (search, events, traces, stats, context packs, export, catalog) per namespace, with scoped tokens, quotas and limits.</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LatticeLog.Ingest\LatticeLog.Ingest.csproj" />
    <ProjectReference Include="..\LatticeLog.Query\LatticeLog.Query.csproj" />
    <ProjectReference Include="..\LatticeLog.Evidence\LatticeLog.Evidence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LatticeLog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web console (P23): static files embedded in the assembly, served at /ui. -->
    <EmbeddedResource Include="ui\**" LogicalName="ui/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
