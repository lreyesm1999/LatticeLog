<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LatticeLog.Core\LatticeLog.Core.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Query\LatticeLog.Query.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Evidence\LatticeLog.Evidence.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.OpenTelemetry\LatticeLog.OpenTelemetry.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Generator\LatticeLog.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\LatticeLog.Mcp\LatticeLog.Mcp.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Cli\LatticeLog.Cli.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Extensions.Logging\LatticeLog.Extensions.Logging.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Ingest\LatticeLog.Ingest.csproj" />
    <ProjectReference Include="..\..\src\LatticeLog.Server\LatticeLog.Server.csproj" />
    <!-- Built first so CrashTests can launch it as a separate process; not referenced as an assembly. -->
    <ProjectReference Include="..\LatticeLog.CrashHarness\LatticeLog.CrashHarness.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyGeneratorForDriverTests" AfterTargets="Build">
    <Copy SourceFiles="..\..\src\LatticeLog.Generator\bin\$(Configuration)\netstandard2.0\LatticeLog.Generator.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
